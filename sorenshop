/* Style de base */
body {
  font-family: 'Roboto', sans-serif;
  margin: 0;
  padding: 0;
  background-color: #f8f8f8;
  color: #333;
}

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

header {
  background-color: #ff4081;
  padding: 20px;
  text-align: center;
  color: white;
}

header h1 {
  font-family: 'Playfair Display', serif;
  font-weight: 600;
}

nav a {
  margin: 0 15px;
  text-decoration: none;
  color: white;
}

.product-list {
  display: flex;
  justify-content: space-between;
  margin-top: 30px;
}

.product-list article {
  width: 30%;
  text-align: center;
  background-color: white;
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.product-list img {
  max-width: 100%;
  border-radius: 8px;
}

.product-page {
  text-align: center;
  margin-top: 50px;
}

.product-page img {
  max-width: 50%;
  border-radius: 8px;
}

.product-description {
  max-width: 700px;
  margin: 20px auto;
}

.price {
  font-size: 1.5em;
  color: #ff4081;
}
